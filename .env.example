# CareerConnect Environment Configuration Example
# Copy this file to `.env` for local overrides or configure in your hosting environment.

# Security
DJANGO_SECRET_KEY=replace-with-a-long-random-50-plus-character-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Email / SMTP Settings (when using SMTP or running with DJANGO_DEBUG=False)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@careerconnect.local

# HTTPS Hardening Overrides (automatically enabled when DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
